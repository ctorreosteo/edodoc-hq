## Template variabili d'ambiente
## Copia questo file in ".env" (non committare) e compila i valori.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# Database (PostgreSQL). In locale: docker compose up -d db
DB_HOST=localhost
DB_PORT=5433
DB_NAME=edodochq
DB_USERNAME=admin
DB_PASSWORD=admin

# Segreto di firma dei token: almeno 32 caratteri casuali (openssl rand -base64 48)
JWT_SECRET=

# Primo avvio: crea l'utente del dottore se non esistono utenti
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dati dimostrativi: solo in locale
APP_INIT_DEMO_ENABLED=false

# Origini consentite (gestionale e app), separate da virgola
CORS_ALLOWED_ORIGINS=http://localhost:*

# Link che apre l'app per impostare la password: il backend aggiunge ?token=
APP_IMPOSTA_PASSWORD_URL=edodoc://imposta-password

# Giorni senza aprire l'app dopo i quali serve di nuovo la password
APP_SESSIONE_GIORNI=60

# Notifiche push dell'app. L'interruttore sta nella tabella config (pagina Impostazioni).
# iOS: chiave .p8 creata su Apple Developer (Keys, con Apple Push Notifications service).
# APNS_SANDBOX=true solo per le build lanciate da Xcode; TestFlight e App Store sono produzione.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_TOPIC=it.edodoc.app
APNS_SANDBOX=false
# Android: percorso ASSOLUTO del JSON del Service Account del progetto Firebase.
FCM_CREDENTIALS_PATH=

# Google Workspace: percorso ASSOLUTO del JSON del Service Account con domain-wide delegation.
# Scope da autorizzare in Google Workspace Admin:
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/gmail.modify (pagina Email e invio)
# L'account impersonato e gli interruttori stanno nella tabella config (pagina Impostazioni).
GOOGLE_CREDENTIALS_PATH=
# true su Cloud Run: niente chiave, il Service Account firma via IAM (ruolo Token Creator su se stesso).
GOOGLE_SENZA_CHIAVE=false

# Cloudflare Stream per i video dei corsi. Token con permesso Stream:Edit.
# L'interruttore sta nella tabella config (pagina Impostazioni).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
